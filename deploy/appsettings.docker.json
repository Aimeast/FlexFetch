{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://*:5080"
      },
      "Https": {
        "Url": "https://*:5081",
        "Certificate": {
          "Path": "/certs/cert.pem",
          "KeyPath": "/certs/privkey.pem"
        }
      }
    }
  },
  "HttpsRedirection": {
    "HttpsPort": 5081
  }
}
