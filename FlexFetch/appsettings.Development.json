{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Network": {
    "Proxy": "socks5://[::1]:1082",
    "HttpProxy": "http://[::1]:1088",
    "RouteRules": [
      {
        "Action": "Direct",
        "Domains": [ "cn" ],
        "CidrFiles": [ "cn-ipv4-list.txt", "cn-ipv6-list.txt" ]
      }
    ],
    "DefaultAction": "UseProxy"
  }
}
